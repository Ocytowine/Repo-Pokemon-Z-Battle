{
  "name": "@pokemon-z-battle/extractor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only extraction tools for a local Pokemon Z installation.",
  "bin": {
    "pokemon-z-extractor": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "extract:pbs": "tsx src/cli.ts extract-pbs",
    "extract:runtime": "tsx src/cli.ts extract-runtime",
    "extract:assets": "tsx src/cli.ts extract-assets",
    "extract:maps": "tsx src/cli.ts extract-maps",
    "prepare:local": "tsx src/cli.ts prepare-local",
    "extract:events": "tsx src/cli.ts extract-events",
    "extract:hooks": "tsx src/cli.ts extract-hooks",
    "inventory": "tsx src/cli.ts inventory",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pokemon-z-battle/game-data": "workspace:*"
  }
}
